# URL base da API usada pelo app (Expo).
# Em build de produção, essa variável é obrigatória.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Project ID do Expo/EAS usado para registrar push nativo.
# Opcional se o valor já estiver em expo.extra.eas.projectId no app.json.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Engine do leitor (atualmente: webview_pdfjs)
EXPO_PUBLIC_NATIVE_READER_ENGINE=webview_pdfjs
